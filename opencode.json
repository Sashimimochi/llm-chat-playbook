{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4:e2b",
  "small_model": "ollama/qwen3:1.7b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://ollama:11434/v1"
      },
      "models": {
        "gemma4:e2b": {
          "name": "Gemma4 2B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tools": true
        },
        "gemma4:e4b": {
          "name": "Gemma4 4B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tools": true
        },
        "qwen3:1.7b": {
          "name": "Qwen3 1.7B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tools": true
        },
        "qwen3:4b": {
          "name": "Qwen3 4B",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "tools": true
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git status": "allow",
      "git add": "allow",
      "git commit": "allow",
      "git push": "allow",
      "git pull": "allow",
      "git clone": "allow",
      "git checkout": "allow",
      "git branch": "allow",
      "git merge": "ask",
      "git log": "allow",
      "git diff": "allow",
      "gh *": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "日本語で記載、作成してください。",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "prompt": "日本語で出力してください。",
      "tools": {
        "read": true,
        "write": true,
        "bash": true
      }
    }
  }
}